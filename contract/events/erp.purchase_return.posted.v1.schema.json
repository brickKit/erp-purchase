{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_return.posted.v1.schema.json",
  "title": "erp.purchase_return.posted.v1",
  "description": "A purchase return line issued by erp/inventory from the receipt movement it names (protocol 05's supplier invoices, 05b's returns). An incremental fact that must not be missed (protocol 05, common rules): consumers dedupe by fact_id and read a missed one back with FactService.Read. fact_id is the return line's ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "return_id",
    "order_id",
    "order_line_id",
    "legal_entity_id",
    "origin_movement_id",
    "movement_id",
    "product_id",
    "base_quantity",
    "business_date",
    "recorded_at"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "format": "uuid"
    },
    "return_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_line_id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "origin_movement_id": {
      "type": "string",
      "format": "uuid"
    },
    "movement_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
