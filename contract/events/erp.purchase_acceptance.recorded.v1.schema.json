{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_acceptance.recorded.v1.schema.json",
  "title": "erp.purchase_acceptance.recorded.v1",
  "description": "A service line's acceptance (the match basis of services and the period-end accrual, protocol 05). An incremental fact that must not be missed (protocol 05, common rules): consumers dedupe by fact_id and read a missed one back with FactService.Read. fact_id is the acceptance line's ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "acceptance_id",
    "order_id",
    "order_line_id",
    "legal_entity_id",
    "quantity",
    "amount",
    "currency",
    "business_date",
    "recorded_at"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "format": "uuid"
    },
    "acceptance_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_line_id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
