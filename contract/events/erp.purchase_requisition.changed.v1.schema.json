{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_requisition.changed.v1.schema.json",
  "title": "erp.purchase_requisition.changed.v1",
  "description": "A purchase requisition's full state (overwriting). Lines approved are turned into order lines; ordered_quantity counts what was.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "legal_entity_id",
    "department_id",
    "requester_id",
    "state",
    "reason",
    "lines",
    "version",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "department_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "requester_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "cancelled",
        "closed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_id",
          "product",
          "quantity",
          "unit",
          "needed_date",
          "ordered_quantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name",
              "unit"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            },
            "description": "the product as it was when the line was made"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string"
          },
          "needed_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "ordered_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
