{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_receipt.changed.v1.schema.json",
  "title": "erp.purchase_receipt.changed.v1",
  "description": "A goods receipt's full state (overwriting): receiving until erp/inventory's movements are in, then posted; failed when erp/inventory refused it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "order_id",
    "order_revision",
    "legal_entity_id",
    "warehouse_id",
    "state",
    "reason",
    "business_date",
    "lines",
    "version",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_revision": {
      "type": "integer",
      "minimum": 1
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "warehouse_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "receiving",
        "posted",
        "failed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order_line_id",
          "quantity",
          "base_quantity",
          "batch",
          "serials",
          "movement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "the receipt line reference"
          },
          "order_line_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "base_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "batch": {
            "type": [
              "string",
              "null"
            ]
          },
          "serials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "movement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
