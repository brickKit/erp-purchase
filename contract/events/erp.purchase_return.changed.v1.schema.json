{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_return.changed.v1.schema.json",
  "title": "erp.purchase_return.changed.v1",
  "description": "A purchase return's full state (overwriting); each line is returned through erp/inventory on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "order_id",
    "legal_entity_id",
    "reason",
    "business_date",
    "lines",
    "version",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order_line_id",
          "receipt_line_id",
          "origin_movement_id",
          "base_quantity",
          "serials",
          "state",
          "movement_id",
          "problem"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order_line_id": {
            "type": "string",
            "format": "uuid"
          },
          "receipt_line_id": {
            "type": "string",
            "format": "uuid"
          },
          "origin_movement_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "serials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "enum": [
              "returning",
              "posted",
              "failed"
            ]
          },
          "movement_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
