{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-purchase/events/erp.purchase_order.changed.v1.schema.json",
  "title": "erp.purchase_order.changed.v1",
  "description": "A purchase order's full state with its lines and their progress (overwriting); also MatchService's view of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "legal_entity_id",
    "supplier_id",
    "supplier",
    "currency",
    "business_date",
    "owner_id",
    "department_id",
    "state",
    "revision",
    "total",
    "submitted_by",
    "approved_by",
    "reason",
    "lines",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "supplier_id": {
      "type": "string",
      "format": "uuid"
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tax_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tax_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "the supplier as it was when the order was made"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "owner_id": {
      "type": "string"
    },
    "department_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "state": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "completed",
        "closed",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "total": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "net of tax"
    },
    "submitted_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "the last rejection's"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "product_id",
          "product",
          "quantity",
          "unit",
          "base_quantity",
          "unit_price",
          "amount",
          "warehouse_id",
          "expected_date",
          "requisition_line_id",
          "project_ref",
          "receiving_base_quantity",
          "received_base_quantity",
          "accepted_quantity",
          "accepted_amount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "goods",
              "service"
            ]
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name",
              "unit"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            },
            "description": "the product as it was when the line was made"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string"
          },
          "base_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "the quantity in the product's base unit (what erp/inventory takes)"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "net of tax, per the line's unit"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "quantity × unit price, rounded to the currency"
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "expected_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "requisition_line_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "project_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiving_base_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "goods: in receipts not posted yet"
          },
          "received_base_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "goods: from erp/inventory's movements, net of returns"
          },
          "accepted_quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "service: accepted, the line's unit"
          },
          "accepted_amount": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
